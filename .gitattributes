# Default: let Git detect text files and normalize committed text to LF.
* text=auto

# Cross-platform source: keep Python blobs and checkouts LF on every OS.
*.py text eol=lf
*.pyi text eol=lf

# Repo control files should not drift by writer platform.
.gitattributes text eol=lf
.gitignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.sh text eol=lf

# Committed data/ruling stores are byte-stable records, not text to normalize.
data/** -text !eol

# Native engine wrapper is vendored/off-limits; preserve bytes exactly.
src/cg/** -text !eol

# Common binary artifacts.
*.dll binary
*.so binary
*.pyd binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.gz binary
*.zip binary
*.7z binary
*.tar binary
*.tgz binary
*.parquet binary
*.pickle binary
*.pkl binary
