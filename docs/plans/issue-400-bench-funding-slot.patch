+def fund_attack_slots(body_key: str, cost_remaining: int, *, quota_spent: bool = False,
+                      promote_first: bool = False) -> list:
     """One slot per missing Energy unit on ``body_key``; unit j's deadline is j−1 turns out
     (1 manual attach/turn — rules.md §3), +1 across the board when this turn's attach is already
     spent. The quota gate re-derived as slot structure: the 3rd needed unit is two turns away, so
-    the copy assigned to it re-accesses over a wider window — derived, not asserted."""
-    base = 1 if quota_spent else 0
+    the copy assigned to it re-accesses over a wider window — derived, not asserted.
+
+    ``promote_first`` shifts every deadline one further out, for a body that must reach the Active
+    spot before it can spend what it is holding — a BENCHED attacker (Issue #400 Phase 2). Same
+    derivation as the quota shift and stacking with it: a later deadline banks wider re-access, so a
+    bench unit prices below the Active's identical unit rather than beside it. It is a separate
+    argument rather than a caller pre-adding 1, because the two shifts mean different things and a
+    reader of a `bench0:unit0` slot at deadline 2 must be able to tell which of them put it there."""
+    base = (1 if quota_spent else 0) + (1 if promote_first else 0)
     return [Slot("fund_attack", ENERGY_TIER, base + j, f"{body_key}:unit{j}")
             for j in range(max(0, int(cost_remaining)))]
 
