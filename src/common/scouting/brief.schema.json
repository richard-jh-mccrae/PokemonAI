{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Matchup Brief",
  "description": "Typed qualitative opponent knowledge for one variant cluster.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "covers", "pokemon", "key_cards", "traits"],
  "properties": {
    "slug": {"type": "string", "description": "matches the filename and data/meta/decks/<slug>/"},
    "label": {"type": "string", "description": "optional human label"},
    "covers": {
      "type": "array", "minItems": 1, "items": {"type": "string"},
      "description": "Archetype strings compiled into candidate-conditioned profiles."
    },
    "authored": {"type": "string", "description": "ISO date the Brief was authored/updated"},
    "traits": {
      "type": "object",
      "description": "Only qualitative claims not derivable from card records.",
      "additionalProperties": false,
      "properties": {
        "tempo": {"enum": ["fast", "midrange", "slow"]},
        "opening_fragility": {"type": "boolean"},
        "heal_wall": {"type": "boolean"},
        "deckout_vulnerability": {"type": "boolean"},
        "setup_dependency": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["primary_attacker", "backup_attacker", "sniper", "draw_engine", "search_engine", "healer", "stall_pokemon", "supporter_tutor", "accel_source", "counter_mover", "item_locker", "retreat_assist", "gust", "support_pokemon"]}
        }
      }
    },
    "pokemon": {
      "type": "array",
      "description": "every Pokémon in the covered deck variants and its deck-specific Role additions",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["card", "roles"],
        "properties": {
          "card": {"type": "string"},
          "roles": {"type": "array", "items": {"type": "string", "enum": ["primary_attacker", "backup_attacker", "sniper", "draw_engine", "search_engine", "healer", "stall_pokemon", "supporter_tutor", "accel_source", "counter_mover", "item_locker", "retreat_assist", "gust", "support_pokemon"]}}
        }
      }
    },
    "key_cards": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["card", "role"], "properties": {"card": {"type": "string"}, "role": {"type": "string"}, "enables": {"type": "string"}}}},
    "strategies": {
      "type": "array",
      "description": "Opponent Strategies supplied by this scouting Brief.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "conditions", "desired_facts", "recipient_selector", "deadline"],
        "anyOf": [
          {"required": ["conviction"]},
          {"required": ["confidence"]}
        ],
        "properties": {
          "identifier": {"type": "string"},
          "conditions": {"type": "array", "items": {"type": "object"}},
          "desired_facts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "recipient_selector": {"type": "string"},
          "deadline": {"enum": ["immediate", "this_turn", "next_turn"]},
          "conviction": {"enum": ["high", "medium", "low"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "bundle_id": {"type": ["string", "null"]},
          "waypoint": {"type": "integer", "minimum": 0},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "sources": {"type": "array", "items": {"type": "string"}, "description": "citations (name — url)"}
  }
}
