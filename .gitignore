__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
/.venv/

# --- Submission build output (assembled by tools/package_agent.py) ---
/dist/

# --- Blunder inspector viewer build (regenerate via viewer/build.py) ---
/tools/train/blunder/viewer/.src/
/tools/train/blunder/viewer/dist/

