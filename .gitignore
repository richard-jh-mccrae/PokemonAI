# --- Credentials (NEVER commit) ---
/kaggle_api_token/
.kaggle/
*access_token*

# --- Local meta_tracker artifacts (Task Scheduler runs locally) ---
/data/meta/
/reports/

# Raw replays are never retained (ADR-0002), but guard against stray files
episode-*-replay.json
/data/probe/

# Raw strategy sources (paid/copyrighted) — kept locally for re-parse, NEVER committed.
# Only the derived Strategy Digests (*_strategy.md) are committed. See strategy-ingest.
/data/strategy/raw/
/data/strategy/transcripts/
# Per-article folders: the pasted source + its full translation are copyrighted reproductions —
# ignore them; the *_strategy.md Digest in the same folder stays committable.
/data/strategy/articles/**/source.txt
/data/strategy/articles/**/translate.txt

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
/.venv/

# --- Submission build output (assembled by tools/submit/package.py) ---
/dist/
# deployed bundles — kept locally forever, not committed (ADR-0019)
/data/submissions/

# --- Blunder inspector viewer build (regenerate via viewer/build.py) ---
/tools/train/blunder/viewer/.src/
/tools/train/blunder/viewer/dist/

# Note: tools/meta_tracker/cards.json IS committed (lets the pipeline run
# without the native engine). data/EN_Card_Data.csv and the sample replay
# fixture under tests/fixtures/ are also committed intentionally.

/data/decks/
/data/meta/
/data/replays/
# machine (auto-labeled) corrections — regenerable from the corpus by tools/train/label (WP3,
# design s3a §D4). The committed human correction tree stays gold; a fresh clone / CI sees none.
/data/corrections/machine/
# score_diff captures are build-specific local artifacts (tools/sim/score_diff.py)
/data/score_diff/
# fetched card scans (tools/arena/images.py) — per-host, never committed
/tools/arena/static/cards/
*.pdf
.claude/settings.local.json# regenerable parity-trace corpus (ADR-0050) - curated fixtures live in tests/fixtures/parity/
/data/parity/
